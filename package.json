{
  "name": "steam-backlog",
  "private": true,
  "version": "0.1.0",
  "description": "Track which games in your Steam library you've finished.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limbon2/steam-backlog.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && node --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
